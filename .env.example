# Public (safe to expose in the browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_PROJECT_ID=your-project-id

# Server-side copies used by TanStack Start / SSR
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_PROJECT_ID=your-project-id

# Server only — never prefix with VITE_ and never import in client code
# Required for admin-bypass server functions. Public review flow also works
# without it via RLS + security-definer RPCs.
SUPABASE_SERVICE_ROLE_KEY=

# Optional public origin used when generating QR codes on the server
# VITE_PUBLIC_APP_URL=http://localhost:5173

# Server only — never prefix with VITE_ and never import in client code.
# Brevo transactional API key (SMTP & API). This is not the SMTP relay password.
# Used only after a confirmed registration to send the welcome and admin emails.
BREVO_API_KEY=
# Shared secret for the database webhook that calls /api/internal/registration-confirmed.
REGISTRATION_NOTIFY_SECRET=
