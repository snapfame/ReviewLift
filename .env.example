# Public (safe to expose in the browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_PROJECT_ID=your-project-id

# Server-side copies used by TanStack Start / SSR
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_PROJECT_ID=your-project-id

# Server only — never prefix with VITE_ and never import in client code
# Required for admin-bypass server functions. Public review flow also works
# without it via RLS + security-definer RPCs.
SUPABASE_SERVICE_ROLE_KEY=

# Optional public origin used when generating QR codes on the server
# VITE_PUBLIC_APP_URL=http://localhost:5173
